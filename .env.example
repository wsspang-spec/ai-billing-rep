# Copy to .env and fill in. Never commit .env.
# AWS Bedrock (Claude). Temporary lab keys need the session token too.
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL=us.anthropic.claude-opus-5-5
# Daytona: runs the invoice comparison in a sandbox, hosts the demo carrier portal
DAYTONA_API_KEY=
# Arize AX: traces + evals
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=ai-billing-rep
# Anchor Browser: files the approved inquiry on the demo portal
ANCHORBROWSER_API_KEY=
# ElevenLabs: generates the voice clarification message
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: public URL of the demo portal (otherwise deployed to a Daytona preview link)
PORTAL_URL=
# Optional: SurrealDB URL (default: embedded surrealkv:// file in local-data/)
BILLING_DB_URL=
